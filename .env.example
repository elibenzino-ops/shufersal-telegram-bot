# ==========================================================
# הגדרות בוט טלגרם להשוואת סלים והזמנות אונליין
# (שופרסל אונליין + חצי חינם אונליין)
# העתק קובץ זה ל-.env ומלא את הפרטים האישיים שלך
# ==========================================================

# 1. טוקן הבוט מטלגרם (מול @BotFather)
# חשוב: ב-@BotFather יש לכבות Privacy Mode (/setprivacy -> Disable) כדי שהבוט יקרא הודעות רגילות בקבוצה!
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_bot_token_here

# 2. מזהי קבוצות מורשות (מופרדים בפסיקים).
# טיפ: ניתן להשאיר ריק בהפעלה הראשונה, לשלוח /id בקבוצה ולהעתיק לכאן את המספר השלילי (למשל -1001234567890)
ALLOWED_CHAT_IDS=

# 3. מזהי משתמשים מנהלים שרשאים לאשר ולבצע הזמנה סופית (/checkout) או לרוקן עגלות (/clear)
# אם ריק – הבוט יאפשר זאת אוטומטית למנהלי הקבוצה בטלגרם (Group Admins)
ADMIN_USER_IDS=

# 4. רשתות מופעלות (מופרדות בפסיקים: shufersal,hazi_hinam)
# ברירת מחדל: שתי הרשתות (שופרסל מופעלת כאשר פרטי ההתחברות שלה מוגדרים)
ENABLED_STORES=shufersal,hazi_hinam

# 5. שופרסל אונליין (https://www.shufersal.co.il/online/he)
SHUFERSAL_USERNAME=your_email@example.com
SHUFERSAL_PASSWORD=your_shufersal_password
# SHUFERSAL_DELIVERY_FEE=29.9

# 6. חצי חינם אונליין (https://shop.hazi-hinam.co.il)
# מילוי אימייל וסיסמה יחבר את העגלה וחלונות המשלוח ישירות לחשבון חצי חינם שלך (OAuth2 + גיבוי התחברות בדפדפן)
# אופציונלי: אם ריק – הבוט עדיין יחפש ויבנה עגלה במצב אורח להשוואת מחירים חיה!
HAZI_HINAM_USERNAME=
HAZI_HINAM_PASSWORD=
# HAZI_HINAM_DELIVERY_FEE=29.9

# 7. מפתח Google Gemini API לזיהוי שפה חופשית ובחירה חכמה של מוצרים (מ-aistudio.google.com)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 8. הגדרות דפדפן ואחסון (ב-Docker אין צורך לשנות!)
HEADLESS=true
# CHROME_PATH=/usr/bin/chromium
# BROWSER_WS_ENDPOINT=
# PROXY_URL=
DATA_DIR=./data

# האם להסיר אוטומטית פריטים שאזלו מהמלאי בעת סגירת ההזמנה בקופה (true / false)
AUTO_REMOVE_OUT_OF_STOCK=true
LOG_LEVEL=info
