# ==========================================================
# הגדרות בוט טלגרם לשופרסל אונליין
# העתק קובץ זה ל-.env ומלא את הפרטים האישיים שלך
# ==========================================================

# 1. טוקן הבוט מטלגרם (מול @BotFather)
# חשוב: ב-@BotFather יש לכבות Privacy Mode (/setprivacy -> Disable) כדי שהבוט יקרא הודעות רגילות בקבוצה!
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_bot_token_here

# 2. מזהי קבוצות מורשות (מופרדים בפסיקים).
# טיפ: ניתן להשאיר ריק בהפעלה הראשונה, לשלוח /id בקבוצה ולהעתיק לכאן את המספר השלילי (למשל -1001234567890)
ALLOWED_CHAT_IDS=

# 3. מזהי משתמשים מנהלים שרשאים לאשר ולבצע הזמנה סופית (/checkout) או לרוקן עגלה (/clear)
# אם ריק – הבוט יאפשר זאת אוטומטית למנהלי הקבוצה בטלגרם (Group Admins)
ADMIN_USER_IDS=

# 4. פרטי ההתחברות לחשבון שופרסל אונליין שלך
SHUFERSAL_USERNAME=your_email@example.com
SHUFERSAL_PASSWORD=your_shufersal_password

# 5. מפתח Google Gemini API לזיהוי שפה חופשית ובחירה חכמה של מוצרים (מ-aistudio.google.com)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 6. הגדרות דפדפן ואחסון (ב-Docker אין צורך לשנות!)
HEADLESS=true
# CHROME_PATH=/usr/bin/chromium
# BROWSER_WS_ENDPOINT=
DATA_DIR=./data

# האם להסיר אוטומטית פריטים שאזלו מהמלאי בעת סגירת ההזמנה בקופה (true / false)
AUTO_REMOVE_OUT_OF_STOCK=true
LOG_LEVEL=info
